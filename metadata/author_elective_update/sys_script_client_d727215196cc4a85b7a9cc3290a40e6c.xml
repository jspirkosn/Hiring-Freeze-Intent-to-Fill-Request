    <name>Validate funding total = 100%</name>
    <script><![CDATA[function onSubmit() {
    var p1 = parseFloat(g_form.getValue('u_fund_pct_1')) || 0;
    var p2 = parseFloat(g_form.getValue('u_fund_pct_2')) || 0;
    var total = p1 + p2;
    if (Math.abs(total - 100) > 0.001) {
        g_form.addErrorMessage('Funding source percentages must total exactly 100%. Current total: ' + total + '%.');
        return false;
    }
}]]></script>
